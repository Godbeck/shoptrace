# Core
PORT=4000
# The database name must sit between the / and the ? or documents land in a
# database called "test".
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/shoptrace?retryWrites=true&w=majority
JWT_SECRET=<long random string>
JWT_EXPIRE=30d

# Background jobs (Upstash). Without this the API still runs - jobs are
# skipped and the expiry sweep can be triggered from the admin endpoint.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Payments
# While Paystack is not connected, this lets POST /api/payments/mock-pay/:orderId
# mark an order paid so the full order lifecycle can be walked. Refused outright
# when NODE_ENV=production. Remove it once Paystack is live.
ALLOW_MOCK_PAYMENTS=true

PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_CALLBACK_URL=shoptrace://payment-complete

# Images - either CLOUDINARY_URL on its own, or the three separate values.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
